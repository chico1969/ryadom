{
  "hosting": {
    "public": "../ui/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source":"**","destination":"/index.html"}],
    "headers": [
      {"source":"**","headers":[
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Frame-Options","value":"DENY"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), display-capture=(), clipboard-read=(self), clipboard-write=(self), fullscreen=(self)"}
      ]},
      {"source":"/index.html","headers":[{"key":"Cache-Control","value":"no-cache"}]},
      {"source":"/flutter_service_worker.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}
    ]
  }
}
