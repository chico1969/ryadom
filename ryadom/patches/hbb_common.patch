diff --git a/src/ryadom_dpapi.rs b/src/ryadom_dpapi.rs
new file mode 100644
--- /dev/null
+++ b/src/ryadom_dpapi.rs
@@ -0,0 +1,140 @@
+use std::{convert::TryFrom, ffi::c_void, io, ptr};
+
+const PREFIX: &[u8] = b"RYADOM-DPAPI-1\0";
+#[repr(C)]
+struct Blob {
+    length: u32,
+    data: *mut u8,
+}
+#[link(name = "crypt32")]
+extern "system" {
+    fn CryptProtectData(
+        input: *const Blob,
+        description: *const u16,
+        entropy: *const Blob,
+        reserved: *mut c_void,
+        prompt: *mut c_void,
+        flags: u32,
+        output: *mut Blob,
+    ) -> i32;
+    fn CryptUnprotectData(
+        input: *const Blob,
+        description: *mut *mut u16,
+        entropy: *const Blob,
+        reserved: *mut c_void,
+        prompt: *mut c_void,
+        flags: u32,
+        output: *mut Blob,
+    ) -> i32;
+}
+#[link(name = "kernel32")]
+extern "system" {
+    fn LocalFree(memory: *mut c_void) -> *mut c_void;
+}
+
+struct Output(Blob);
+impl Drop for Output {
+    fn drop(&mut self) {
+        if !self.0.data.is_null() {
+            unsafe {
+                LocalFree(self.0.data.cast());
+            }
+        }
+    }
+}
+
+fn transform(data: &[u8], peer: &str, protect: bool, machine: bool) -> io::Result<Vec<u8>> {
+    let length = u32::try_from(data.len())
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "Credential too large"))?;
+    let input = Blob {
+        length,
+        data: data.as_ptr() as *mut u8,
+    };
+    let entropy = Blob {
+        length: peer.len() as u32,
+        data: peer.as_ptr() as *mut u8,
+    };
+    let mut out = Output(Blob {
+        length: 0,
+        data: ptr::null_mut(),
+    });
+    // Both APIs allocate the output with LocalAlloc. Output owns it on every return path.
+    let ok = unsafe {
+        if protect {
+            CryptProtectData(
+                &input,
+                ptr::null(),
+                &entropy,
+                ptr::null_mut(),
+                ptr::null_mut(),
+                if machine { 5 } else { 1 },
+                &mut out.0,
+            )
+        } else {
+            CryptUnprotectData(
+                &input,
+                ptr::null_mut(),
+                &entropy,
+                ptr::null_mut(),
+                ptr::null_mut(),
+                1,
+                &mut out.0,
+            )
+        }
+    };
+    if ok == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if out.0.data.is_null() || out.0.length > 1024 * 1024 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "Invalid DPAPI output",
+        ));
+    }
+    Ok(unsafe { std::slice::from_raw_parts(out.0.data, out.0.length as usize) }.to_vec())
+}
+pub fn seal(data: &[u8], peer: &str) -> io::Result<Vec<u8>> {
+    if data.is_empty() {
+        return Ok(Vec::new());
+    }
+    let mut result = PREFIX.to_vec();
+    result.extend(transform(data, peer, true, false)?);
+    Ok(result)
+}
+pub fn is_protected(data: &[u8]) -> bool {
+    data.starts_with(PREFIX)
+}
+pub fn open(data: &[u8], peer: &str) -> io::Result<Vec<u8>> {
+    let encrypted = data
+        .strip_prefix(PREFIX)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "Invalid credential format"))?;
+    transform(encrypted, peer, false, false)
+}
+
+pub fn seal_machine(data: &[u8], context: &str) -> io::Result<Vec<u8>> {
+    if data.is_empty() || is_protected(data) {
+        return Ok(data.to_vec());
+    }
+    let mut result = PREFIX.to_vec();
+    result.extend(transform(data, context, true, true)?);
+    Ok(result)
+}
+
+pub fn open_identity(pair: &mut (Vec<u8>, Vec<u8>)) -> io::Result<()> {
+    if is_protected(&pair.0) {
+        pair.0 = open(&pair.0, "Ryadom.device-key.v1")?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn password_is_bound_to_user_and_peer() {
+        let data = seal(b"salted-password-hash", "peer-a").unwrap();
+        assert!(!data.windows(20).any(|v| v == b"salted-password-hash"));
+        assert_eq!(open(&data, "peer-a").unwrap(), b"salted-password-hash");
+        assert!(open(&data, "peer-b").is_err());
+    }
+}
diff --git a/src/ryadom_network.rs b/src/ryadom_network.rs
new file mode 100644
--- /dev/null
+++ b/src/ryadom_network.rs
@@ -0,0 +1,185 @@
+use crate::{anyhow::anyhow, bail, ResultType};
+use serde_derive::Deserialize;
+use webrtc::{ice::url::Url, ice_transport::ice_server::RTCIceServer};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TurnServer {
+    urls: Vec<String>,
+    username: String,
+    credential: String,
+}
+
+pub fn parse_turn_servers(raw: &str) -> ResultType<Vec<RTCIceServer>> {
+    if raw.len() > 16 * 1024 {
+        bail!("Конфигурация TURN слишком велика");
+    }
+    if raw.trim().is_empty() {
+        return Ok(Vec::new());
+    }
+    let servers: Vec<TurnServer> = serde_json::from_str(raw)?;
+    if servers.len() > 8 {
+        bail!("Слишком много серверов TURN");
+    }
+    servers
+        .into_iter()
+        .map(|server| {
+            if server.urls.is_empty()
+                || server.urls.len() > 8
+                || server.username.is_empty()
+                || server.username.len() > 256
+                || server.credential.is_empty()
+                || server.credential.len() > 1024
+            {
+                bail!("Некорректные параметры TURN");
+            }
+            for url in &server.urls {
+                if url.len() > 1024 || !(url.starts_with("turn:") || url.starts_with("turns:")) {
+                    bail!("Ожидается адрес TURN");
+                }
+                Url::parse_url(url).map_err(|_| anyhow!("Некорректный адрес TURN"))?;
+            }
+            Ok(RTCIceServer {
+                urls: server.urls,
+                username: server.username,
+                credential: server.credential,
+            })
+        })
+        .collect()
+}
+
+pub const OWNER_TURN_OPTION: &str = "ryadom-owner-turn-dpapi-v1";
+pub const TURN_DISABLED_OPTION: &str = "ryadom-turn-disabled";
+const CONTEXT: &str = "Ryadom.TURN.owner.v1";
+
+#[cfg(feature = "ryadom-bundled-turn")]
+mod bundled {
+    include!(env!("RYADOM_TURN_BUNDLE_SOURCE"));
+    pub(super) fn servers(
+    ) -> crate::ResultType<Vec<webrtc::ice_transport::ice_server::RTCIceServer>> {
+        use crate::{anyhow::anyhow, sodiumoxide::crypto::secretbox};
+        let key =
+            secretbox::Key::from_slice(KEY).ok_or_else(|| anyhow!("Некорректный тестовый ключ"))?;
+        let nonce = secretbox::Nonce::from_slice(NONCE)
+            .ok_or_else(|| anyhow!("Некорректная тестовая конфигурация"))?;
+        let raw = secretbox::open(SEALED, &nonce, &key)
+            .map_err(|_| anyhow!("Не открыта тестовая конфигурация TURN"))?;
+        super::parse_turn_servers(std::str::from_utf8(&raw)?)
+    }
+}
+
+pub fn bundled_test_build() -> bool {
+    cfg!(feature = "ryadom-bundled-turn")
+}
+
+#[cfg(windows)]
+pub fn protect_owner_config(raw: &str) -> ResultType<String> {
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    let servers = parse_turn_servers(raw)?;
+    if servers.is_empty() {
+        return Ok(String::new());
+    }
+    Ok(STANDARD.encode(crate::ryadom_dpapi::seal(raw.as_bytes(), CONTEXT)?))
+}
+
+#[cfg(windows)]
+fn load_owner_config() -> ResultType<Vec<RTCIceServer>> {
+    use base64::{engine::general_purpose::STANDARD, Engine};
+    let protected = crate::config::Config::get_option(OWNER_TURN_OPTION);
+    if protected.is_empty() {
+        return Ok(Vec::new());
+    }
+    let raw = crate::ryadom_dpapi::open(&STANDARD.decode(protected)?, CONTEXT)?;
+    parse_turn_servers(std::str::from_utf8(&raw)?)
+}
+
+pub fn turn_servers() -> Vec<RTCIceServer> {
+    if crate::config::Config::get_option(TURN_DISABLED_OPTION) == "Y" {
+        return Vec::new();
+    }
+    #[cfg(windows)]
+    let owner = match load_owner_config() {
+        Ok(servers) => servers,
+        Err(_) => {
+            crate::throttled_log!(
+                std::time::Duration::from_secs(60),
+                warn,
+                "Рядом: не удалось открыть личную настройку TURN; локальный резерв отключён"
+            );
+            Vec::new()
+        }
+    };
+    #[cfg(not(windows))]
+    let owner = Vec::new();
+    if !owner.is_empty() {
+        return owner;
+    }
+    #[cfg(feature = "ryadom-bundled-turn")]
+    match bundled::servers() {
+        Ok(servers) => return servers,
+        Err(_) => crate::throttled_log!(
+            std::time::Duration::from_secs(60),
+            warn,
+            "Рядом: тестовый TURN не настроен корректно"
+        ),
+    }
+    Vec::new()
+}
+
+pub fn relay_allowed() -> bool {
+    true
+}
+
+pub fn check_transport(relayed: Option<bool>, allow_relay: bool) -> ResultType<()> {
+    match relayed {
+        Some(false) => Ok(()),
+        Some(true) if allow_relay => Ok(()),
+        Some(true) => Err(anyhow!("Резервный TURN не настроен")),
+        None => Err(anyhow!("Не удалось подтвердить выбранный транспорт")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn ryadom_turn_configuration_and_transport_policy() {
+        let raw = r#"[{"urls":["turn:relay.example.com:80?transport=tcp","turns:relay.example.com:443?transport=tcp"],"username":"test","credential":"test"}]"#;
+        assert_eq!(parse_turn_servers(raw).unwrap()[0].urls.len(), 2);
+        assert!(parse_turn_servers(&raw.replace("turn:relay", "https:relay")).is_err());
+        assert!(
+            parse_turn_servers(&raw.replace("\"credential\":\"test\"", "\"apiKey\":\"test\""))
+                .is_err()
+        );
+        assert!(parse_turn_servers("").unwrap().is_empty());
+        assert!(check_transport(Some(false), false).is_ok());
+        assert!(check_transport(Some(true), false).is_err());
+        assert!(check_transport(Some(true), true).is_ok());
+        assert!(check_transport(None, true).is_err());
+    }
+
+    #[cfg(windows)]
+    #[test]
+    fn ryadom_owner_turn_is_protected_for_local_user() {
+        use base64::{engine::general_purpose::STANDARD, Engine};
+        let raw = r#"[{"urls":["turn:relay.example.com:3478"],"username":"test","credential":"private-test-password"}]"#;
+        let encrypted = STANDARD.decode(protect_owner_config(raw).unwrap()).unwrap();
+        assert!(!encrypted
+            .windows(21)
+            .any(|window| window == b"private-test-password"));
+        assert_eq!(
+            crate::ryadom_dpapi::open(&encrypted, CONTEXT).unwrap(),
+            raw.as_bytes()
+        );
+        assert!(crate::ryadom_dpapi::open(&encrypted, "another-purpose").is_err());
+        assert_eq!(protect_owner_config("[]").unwrap(), "");
+    }
+    #[cfg(feature = "ryadom-bundled-turn")]
+    #[test]
+    fn ryadom_bundled_test_turn_opens_valid_configuration() {
+        crate::sodiumoxide::init().unwrap();
+        let servers = bundled::servers().unwrap();
+        assert!(!servers.is_empty());
+        assert!(servers.iter().all(|server| !server.credential.is_empty()));
+    }
+}
