+#[cfg(any(feature = "direct-only", test))]
+fn direct_pair_status(description:&str)->Option<bool> {
+    let types:Vec<_>=description.split(" <-> ").filter_map(|side|side.split_whitespace().nth(2)).collect();
+    if types.len()!=2 { return None; }
+    if types.iter().any(|typ|*typ=="relay") { return Some(true); }
+    types.iter().all(|typ|matches!(*typ,"host"|"srflx"|"prflx")).then_some(false)
+}
