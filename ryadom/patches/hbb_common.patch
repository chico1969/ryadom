+    use super::direct_pair_status;
+    #[test]
+    fn unknown_pair_does_not_claim_direct_connectivity() {
+        assert_eq!(direct_pair_status("(local) udp host 10.0.0.1:5000 <-> (remote) udp srflx 10.0.0.2:5000"),Some(false));
+        assert_eq!(direct_pair_status("(local) udp host 10.0.0.1:5000 <-> (remote) udp relay 10.0.0.2:5000"),Some(true));
+        assert_eq!(direct_pair_status("unrecognized display"),None);
+        assert_eq!(direct_pair_status("udp4 addr new-type <-> udp4 addr host"),None);
