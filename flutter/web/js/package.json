  },
  "devDependencies": {
    "@types/dom-webcodecs": "0.1.11",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "esbuild": "0.25.0",
    "jest": "29.7.0",
    "playwright": "1.65.0",
    "ts-jest": "29.2.6",
    "typescript": "5.7.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/*.test.ts"
    ]
